# 🔹 Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Allow data folder
!data/
!data/*.xlsx

# 🔹 Virtual environment
venv/
.env/
env/

# 🔹 VS Code settings
.vscode/

# 🔹 System files
.DS_Store
Thumbs.db

# 🔹 Logs
*.log

# 🔹 Excel outputs (generated files)
output/

# Ignore Excel everywhere EXCEPT data folder
*.xlsx
!data/*.xlsx

# 🔹 Temporary files
*.tmp
*.temp

# 🔹 Python packaging
build/
dist/
*.egg-info/